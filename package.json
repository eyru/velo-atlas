{
  "name": "velo-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode offline",
    "build:offline": "pnpm build:single && node scripts/build-standalone.mjs",
    "check": "node scripts/check-data.mjs",
    "verify": "pnpm check && pnpm build",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "0.25.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}